{
  "name": "lab1-projekti",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix backend install --legacy-peer-deps && npm --prefix frontend install",
    "migrate": "npm --prefix backend run migrate",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\""
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "mysql2": "^3.20.0",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "resend": "^6.12.3",
    "sql.js": "^1.14.1"
  }
}
