generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emri             String?
  email            String?         @unique
  password         String?
  roli             user_role?
  created_at       DateTime?       @default(now()) @db.Timestamp(6)
  emri_organizates String?
  pershkrimi       String?
  telefoni         String?
  website          String?
  Attendance       Attendance[]
  Events           Events[]        @relation("UserEvents")
  Feedback         Feedback[]
  RefreshTokens    RefreshTokens[]
  Registrations    Registrations[]
}

model Events {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulli          String?
  pershkrimi       String?
  data_fillimit    DateTime?        @db.Timestamp(6)
  data_perfundimit DateTime?        @db.Timestamp(6)
  lokacioni        String?
  kapaciteti       BigInt?
  statusi          String?
  organizer_id     String?          @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id      String?          @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imazhi           String?
  venue_id         String?          @db.Uuid
  Attendance       Attendance[]
  EventSchedules   EventSchedules[]
  Event_Speakers   Event_Speakers[]
  Event_Sponsors   Event_Sponsors[]
  EventCategories  EventCategories? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OrganizerUser    Users?           @relation("UserEvents", fields: [organizer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Venues           Venues?          @relation(fields: [venue_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Feedback         Feedback[]
  Registrations    Registrations[]
  TicketTypes      TicketTypes[]
  Tickets          Tickets[]
}

model Attendance {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registration_id String?        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id        String?        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  check_in_time   DateTime?      @db.Timestamp(6)
  check_out_time  DateTime?      @db.Timestamp(6)
  statusi_checkin String?
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  Events          Events?        @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Registrations   Registrations? @relation(fields: [registration_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Users           Users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model EventCategories {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emri   String?
  Events Events[]
}

model EventSchedules {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id        String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulli_eventit String?
  pershkrimi      String?
  ora_fillimit    DateTime? @db.Timestamp(6)
  ora_mbarimit    DateTime? @db.Timestamp(6)
  salla           String?
  speaker_id      String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  Events          Events?   @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Speakers        Speakers? @relation(fields: [speaker_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Event_Speakers {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id   String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  speaker_id String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tema       String?
  ora        DateTime? @db.Timestamp(6)
  Events     Events?   @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Speakers   Speakers? @relation(fields: [speaker_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Event_Sponsors {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id   String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sponsor_id String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shuma      Decimal?  @db.Decimal
  Events     Events?   @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Sponsors   Sponsors? @relation(fields: [sponsor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Feedback {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id  String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id   String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vleresimi BigInt?
  komenti   String?
  data      DateTime? @db.Timestamp(6)
  Events    Events?   @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Users     Users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Payments {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registration_id String?        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shuma           Decimal?       @db.Decimal
  metoda          String?
  data            DateTime?      @db.Timestamp(6)
  statusi         String?
  Registrations   Registrations? @relation(fields: [registration_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model RefreshTokens {
  id         Int       @id @default(autoincrement())
  user_id    String    @db.Uuid
  token_jti  String    @unique
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  Users      Users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_refresh_tokens_expires_at")
  @@index([user_id], map: "idx_refresh_tokens_user_id")
}

model Registrations {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id          String?      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String?      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id         String?      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  data_regjistrimit DateTime?    @default(now()) @db.Timestamp(6)
  statusi           String?
  reminder_sent     Boolean      @default(false)
  Attendance        Attendance[]
  Payments          Payments[]
  Events            Events?      @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Tickets           Tickets?     @relation(fields: [ticket_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Users             Users?       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Speakers {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emri           String?
  mbiemri        String?
  biografia      String?
  imazhi         String?
  email          String?
  EventSchedules EventSchedules[]
  Event_Speakers Event_Speakers[]
}

model Sponsors {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emri                 String?
  logoja               String?
  website              String?
  niveli_sponsorizimit String?
  Event_Sponsors       Event_Sponsors[]
}

model TicketTypes {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id     String?  @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emri_llojit  String?
  pershkrimi   String?
  cmimi        Decimal? @db.Decimal
  sasia_total  BigInt?
  sasia_mbetur BigInt?
  statusi      String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  Events       Events?  @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Tickets {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id      String?         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipi          String?
  cmimi         Decimal?        @db.Decimal
  sasia         BigInt?
  Registrations Registrations[]
  Events        Events?         @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Venues {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emri       String?
  adresa     String?
  qyteti     String?
  kapaciteti BigInt?
  pershkrimi String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  Events     Events[]
}

model schema_migrations {
  id          Int      @id @default(autoincrement())
  filename    String   @unique
  executed_at DateTime @default(now()) @db.Timestamptz(6)
}

enum user_role {
  admin
  organizer
  user
}
